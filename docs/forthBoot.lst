XAS99 CROSS-ASSEMBLER   VERSION 3.6.5
     **** ****     > boot.a99
0001                       COPY "../mux.a99"
     **** ****     > ../mux.a99
0001      F000     MUX0    EQU >F000
0002      F000     M0STAT  EQU >F000                       ;  Read status: bit 0 = Transmit Busy, bit 1 = Data Received
0003      F002     M0RX    EQU >F002                       ;  Read byte received in 8 LSB
0004      F003     M0RXB   EQU >F003                       ;  Read byte received
0005      F004     M0TX    EQU >F004                       ;  Write byte to send in 8 LSB
0006      F005     M0TXB   EQU >F005                       ;  Write byte to send
0007      F006     M0RST   EQU >F006                       ;  Write to reset interrupt and Data Received status
0008      0002     M0IRQ   EQU >2                          ;  IRQ for Mux0
0009               
0010                                                       ; Mux1 constants
0011      F008     MUX1    EQU >F008
0012      F008     M1STAT  EQU >F008
0013      F00A     M1RX    EQU >F00A
0014      F00B     M1RXB   EQU >F00B
0015      F00C     M1TX    EQU >F00C
0016      F00D     M1TXB   EQU >F00D
0017      F00E     M1RST   EQU >F00E
0018      0003     M1IRQ   EQU >3
                   < boot.a99
0002                       COPY "../addrs.a99"
     **** ****     > ../addrs.a99
0001      0000     VECTORS EQU >0000
0002      0040     TRAPS   EQU >0040
0003      0080     GENERAL EQU >0080
0004      1000     RAM_START EQU >1000
0005      3FFE     RAM_END EQU >3FFE
                   < boot.a99
0003               
0004      0004     TMRIRQ  EQU >4                          ; Timer IRQ
0005      F010     TMRRST  EQU >F010
0006               
0007               ;*************************************************
0008               ;                       Stacks
0009      3ED0     T0_SP   EQU >4000 - >130
0010      3500     T1_SP   EQU >3500
0011               
0012                       DORG >4000 - 128
0013               ;*************************************************
0014               ;                       Task Workspaces
0015 3F80          T0_WP   BSS 32
0016 3FA0          T1_WP   BSS 32
0017               
0018               ;*************************************************
0019               ;                       Scheduler RAM
0020 3FC0          OSWP    BSS 32                          ; Set aside 32 bytes/16 words for primary workspace
0021               
0022               TCBS                                    ; Start of TCB Table
0023 3FE0                  BSS 6                           ; WP,PC,ST
0024 3FE6                  BSS 6
0025               TCBE                                    ; End of TCB Table
0026               
0027 3FEC          TCUR    BSS 2                           ; Pointer to TCB for current task
0028               
0029 3FEE          M0STATC BSS 2
0030 3FF0          M1STATC BSS 2
0031 3FF2          TIMER_TICK BSS 2                        ; Incremented on each hardware timer interrupt (not yield)
0032               
0033               ;*************************************************
0034               ;                       ROM Start
0035                       AORG >0000                      ; Reset Vector...
0036 0000 3FC0             DATA OSWP                       ;       OS workspace addr
0037 0002 00C0             DATA UNZIP                      ;       Init code
0038               
0039               YIELDV  AORG >4                         ; Yield Vector (BLWP @>0004 from C yield macro)
0040 0004 3FC0             DATA OSWP                       ;       OS Workspace (shared with timer ISR)
0041 0006 0096             DATA ISR_YIELD                  ;       Skips timer-only counter increment
0042               
0043               M0IRQV  AORG M0IRQ * 4
0044 0008 3FC0             DATA OSWP
0045 000A 0014             DATA ISR_MUX_0
0046               
0047               M1IRQV  AORG M1IRQ * 4
0048 000C 3FC0             DATA OSWP
0049 000E 0014             DATA ISR_MUX_1
0050               
0051               TIMERV  AORG TMRIRQ * 4                 ; Timer Vector
0052 0010 3FC0             DATA OSWP                       ;       OS Workspace
0053 0012 008A             DATA ISR_TIMER                  ;       Scheduler code
0054               
0055               ISR_MUX_0
0056               ISR_MUX_1
0057 0014 C820  42         MOV @M0STAT, @M0STATC
     0016 F000     
     0018 3FEE     
0058 001A C820  42         MOV @M1STAT, @M1STATC
     001C F008     
     001E 3FF0     
0059 0020 04E0  26         CLR @M0RST
     0022 F006     
0060 0024 04E0  26         CLR @M1RST
     0026 F00E     
0061 0028 0380  14         RTWP
0062               
0063               ;*************************************************
0064               ;                       TCB Initialization
0065               TCB_INIT_DATA                           ; Initial Ram Values
0066 002A 3F80             DATA T0_WP, UNZIP_DATA, >0004   ; Task 0 TCB //TODO FIX INT MASK!!!
     002C 1000     
     002E 0004     
0067 0030 3FA0             DATA T1_WP, UNZIP_DATA, >0004   ; Task 1 TCB
     0032 1000     
     0034 0004     
0068               TCB_INIT_DATA_END
0069               
0070               TCB_INIT
0071 0036 0200  12         LI R0, TCB_INIT_DATA            ; Copy TCBs from ROM to RAM
     0038 002A     
0072 003A 0201  12         LI R1, TCBS
     003C 3FE0     
0073 003E 0202  12         LI R2, (TCB_INIT_DATA_END-TCB_INIT_DATA)/2
     0040 0006     
0074               TCB_INIT_COPY
0075 0042 CC70  42         MOV *R0+, *R1+
0076 0044 0602  10         DEC R2
0077 0046 16FD  10         JNE TCB_INIT_COPY
0078               
0079               INIT_STACKS
0080 0048 0201  12         LI R1, >0002
     004A 0002     
0081 004C C801  30         MOV R1, @M0STATC
     004E 3FEE     
0082 0050 C801  30         MOV R1, @M1STATC
     0052 3FF0     
0083               
0084 0054 0201  12         LI R1, MUX0
     0056 F000     
0085 0058 C801  30         MOV R1, @T0_WP + (1 * 2)
     005A 3F82     
0086 005C 0201  12         LI R1, M0STATC
     005E 3FEE     
0087 0060 C801  30         MOV R1, @T0_WP + (2 * 2)
     0062 3F84     
0088 0064 0201  12         LI R1, T0_SP
     0066 3ED0     
0089 0068 C801  30         MOV R1, @T0_WP + (10 * 2)
     006A 3F94     
0090               
0091 006C 0201  12         LI R1, MUX1
     006E F008     
0092 0070 C801  30         MOV R1, @T1_WP + (1 * 2)
     0072 3FA2     
0093 0074 0201  12         LI R1, M1STATC
     0076 3FF0     
0094 0078 C801  30         MOV R1, @T1_WP + (2 * 2)
     007A 3FA4     
0095 007C 0201  12         LI R1, T1_SP
     007E 3500     
0096 0080 C801  30         MOV R1, @T1_WP + (10 * 2)
     0082 3FB4     
0097                       ;B @UNZIP_DATA
0098               
0099                                                       ; Load and run Task 1
0100 0084 0201  12         LI R1, TCBS                     ; Set the first task as the "next" to run
     0086 3FE0     
0101 0088 1015  10         JMP ISR_TIMER_RESUME            ; Jump straight to resume it!
0102               
0103               ;*************************************************
0104               ;                       Scheduler
0105               ISR_TIMER
0106 008A 0300  14         LIMI 0                          ; INT OFF
     008C 0000     
0107 008E 04E0  26         CLR @TMRRST                     ; MMIO Write to clear timer interrupt
     0090 F010     
0108 0092 05A0  26         INC @TIMER_TICK                 ; Count hardware timer ticks (not yield)
     0094 3FF2     
0109                                                       ; fall through to ISR_YIELD
0110               
0111               ISR_YIELD                               ; Entry for BLWP @>0004 (yield from C getchar/putchar)
0112 0096 0300  14         LIMI 0                          ; INT OFF - interrupts may be on at yield point
     0098 0000     
0113               
0114 009A C020  26         MOV @TCUR, R0                   ;Load current TCB address to R0
     009C 3FEC     
0115 009E C040  14         MOV R0, R1                      ;Copy to R1...
0116 00A0 0221  14         AI R1, >6                       ;and increment to next TCB
     00A2 0006     
0117               
0118                                                       ;Loop back around to the first task
0119 00A4 0281  14         CI R1, TCBE                     ;If next task is NOT past the end of the TCB Table
     00A6 3FEC     
0120 00A8 1602  10         JNE ISR_TIMER_SWAP              ;THEN goto SWAP
0121 00AA 0201  12         LI R1, TCBS                     ;ELSE set it to the first one
     00AC 3FE0     
0122               ISR_TIMER_SWAP
0123               
0124               ISR_TIMER_SUSPEND                       ;Suspend task to TCB in R0
0125 00AE CC0D  30         MOV R13, *R0+                   ; Save context to TCB
0126 00B0 CC0E  30         MOV R14, *R0+
0127 00B2 CC0F  30         MOV R15, *R0+
0128               ISR_TIMER_RESUME                        ;Resume task from TCB in R1
0129 00B4 C801  30         MOV R1, @TCUR                   ; Save as current task
     00B6 3FEC     
0130 00B8 C371  26         MOV *R1+, R13                   ; Restore context from TCB
0131 00BA C3B1  26         MOV *R1+, R14
0132 00BC C3F1  26         MOV *R1+, R15
0133 00BE 0380  14         RTWP
0134               
0135               
0136               ;*************************************************
0137               ;                       Decompress
0138               UNZIP                                   ;Uncompress
0139 00C0 0200  12         LI R0, UNZIP_COMPRESSED_DATA    ;Input data in rom
     00C2 017C     
0140 00C4 0201  12         LI R1, UNZIP_DATA               ;output in ram
     00C6 1000     
0141 00C8 06A0  20         BL @DZX0                        ;Call
     00CA 00CE     
0142 00CC 10B4  10         JMP TCB_INIT
